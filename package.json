{
  "name": "climate-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "기후변화 탐사 연구소 — 4학년 과학 4단원 수업용 웹앱",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "check:data": "node scripts/check-data.mjs",
    "check:text": "node scripts/check-text.mjs",
    "test": "vitest run",
    "test:screen": "node scripts/screen-check.mjs",
    "qr": "node scripts/make-qr.mjs",
    "check": "npm run check:data && npm run check:text && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "lz-string": "1.5.0",
    "pretendard": "1.3.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "qrcode": "1.5.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
